{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.js",
    "scripts/**/*.js",
    "site/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "site-dist",
    "packages/html/src/default_styles.js"
  ]
}
