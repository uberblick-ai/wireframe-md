{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",

  // Lint only, as in uberblick-2: no formatter, no assist actions.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },

  // Reuse .gitignore so node_modules/ and dist/ stay out.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },

  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          // Tests assert `expect(x).toBeDefined()` and then use `x!`.
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
